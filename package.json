{
  "name": "xunzhan",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43127",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43127",
    "desktop": "electron . --no-sandbox --disable-gpu --disable-dev-shm-usage",
    "package": "XUNZHAN_DIST=.next-release next build && XUNZHAN_DIST=.next-release node scripts/stage-standalone.mjs && electron-builder --linux dir",
    "lint": "eslint",
    "test": "tsx --test src/lib/policy.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "teleproto": "^1.229.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "build": {
    "appId": "local.xunzhan.desk",
    "productName": "Xunzhan",
    "executableName": "xunzhan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "beforeBuild": "scripts/skip-deps.cjs",
    "extraResources": [
      {
        "from": "release/payload",
        "to": "payload"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network"
    }
  }
}
